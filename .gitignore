# ---------------------------------------------------------------------------
# Pipeline working directory. Everything the notebook writes lands here, and
# none of it belongs in version control: the models and checkpoints are large,
# and the figures and logs are regenerated by re-running the notebook.
# ---------------------------------------------------------------------------
Dissertation_ECGB/
data/
checkpoints/
models/
logs/
figures/
optuna_studies/
deployment/

# Optuna study databases and the pipeline stage log
*.db
*.sqlite3

# Model artifacts and checkpoints
*.pkl
*.joblib
crgb_final*.json
crgb_lambda0_twin.json

# PaySim itself is not redistributed here - download it from Kaggle.
# See the README.
*.csv
!requirements.txt

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Notebook and editor noise
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
.jupyter/
.virtual_documents/
.DS_Store
Thumbs.db
.idea/
.vscode/

